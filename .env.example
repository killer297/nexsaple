# Copy this file to .env and fill in your real values. Never commit .env.

PORT=3000

# SMTP credentials — where the contact form emails are sent FROM
# Example for Gmail: host=smtp.gmail.com, port=587, user=your address,
# pass=a 16-character Gmail "App Password" (not your normal password).
# Example for your own hosting: ask your hosting provider for SMTP host/port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nexsaple726@gmail.com
SMTP_PASS=Qazx@123

# Where inquiries should be delivered TO
CONTACT_EMAIL=nexsaple726@gmail.com

# Secret key to view stored submissions at /api/submissions?key=...
ADMIN_KEY=choose-a-long-random-string
